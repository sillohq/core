---
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import SiteTitle from '../SiteTitle.astro';
import SocialIcons from '../SocialIcons.astro';
import ThemeSelect from '../ThemeSelect.astro';
const { sidebar } = Astro.locals.starlightRoute;

/** Filter sidebar groups to only show entries relevant to the current URL section. */
function filterSidebar(sidebar: StarlightRouteData['sidebar'], pathname: string) {
    const locale = Astro.currentLocale;
    // Strip Astro base path so route-aware filtering uses the actual content path
    const base = import.meta.env.BASE_URL;
    const pathWithoutBase = pathname.startsWith(base) ? pathname.slice(base.length) : pathname;
    const pathWithoutLocale = locale
        ? pathWithoutBase.replace(new RegExp(`^/${locale}`), '') || '/'
        : pathWithoutBase;
    const section = pathWithoutLocale.split('/').filter(Boolean)[0];
    const sectionPrefix = `/${section}/`;

    return sidebar.filter((entry) => {
        if (entry.type === 'link') {
            return entry.href.startsWith(sectionPrefix);
        }
        return entry.entries.some(
            (link) => link.type === 'link' && link.href.startsWith(sectionPrefix)
        );
    });
}

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const pathWithoutBase = currentPath.startsWith(base) ? currentPath.slice(base.length) : currentPath;
const isRoot = pathWithoutBase === '/' || pathWithoutBase === '';
const filteredSidebar = isRoot ? sidebar : filterSidebar(sidebar, currentPath);
---

<div popover="auto" id="drawer">
    <button class="sheet-overlay" popovertarget="drawer" popovertargetaction="hide"></button>
    <div class="content">
        <div class="header">
            <button class="drag-icon" popovertarget="drawer" popovertargetaction="hide">
                <span></span>
            </button>
            <div class="drawer-logo">
                <SiteTitle />
            </div>
        </div>
        <div class="body">
            <div class="links-docs">
                {
                    filteredSidebar.map(
                        (entry) =>
                            entry.type !== 'link' && (
                                <div class="container-sidebar-entry">
                                    <h4 class="entry-title">{entry.label}</h4>

                                    {entry.entries.map(
                                        (link) =>
                                            link.type === 'link' && (
                                                <a
                                                    href={link.href}
                                                    {...link.attrs}
                                                    data-active={currentPath === link.href}
                                                >
                                                    {link.label}
                                                </a>
                                            )
                                    )}
                                </div>
                            )
                    )
                }
            </div>

            <footer class="drawer-footer">
                <SocialIcons />
                <ThemeSelect />
            </footer>
        </div>
    </div>
</div>

<style>
    button {
        all: unset;
    }

    [popover] {
        padding: 0;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        display: flex;
        opacity: 0;
        pointer-events: none;
        align-items: center;
        flex-direction: column;
        justify-content: flex-end;
        transition: 0.1s linear;
        z-index: 1000;
        background: transparent;
        border: none;
        overflow: hidden;
    }

    [popover]::backdrop {
        background: color-mix(in oklab, black 80%, transparent);
        backdrop-filter: blur(2px);
    }

    [popover]:popover-open {
        opacity: 1;
        pointer-events: auto;
    }

    [popover]:popover-open .content {
        transform: translateY(0%);
    }

    .sheet-overlay {
        position: fixed;
        top: 0;
        left: 0;
        z-index: -1;
        width: 100vw;
        height: 100vh;
        opacity: 0.1;
        background-color: transparent;
    }

    .content {
        width: 100%;
        position: relative;
        background: var(--background);
        max-height: 100vh;
        height: 70vh;
        max-width: 1150px;
        transform: translateY(100%);
        border-radius: 12px 12px 0 0;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.03);
        transition: 0.3s ease;
    }

    .header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: calc(var(--spacing) * 1);
        padding-top: calc(var(--spacing) * 2);
    }

    .drawer-logo :global(.site-title) {
        margin-right: 0;
    }

    .drawer-logo :global(.logo) {
        max-height: 2.5rem;
        max-width: 2.5rem;
    }

    .drawer-logo :global(.title-text) {
        font-size: 1.5rem;
    }

    .header .drag-icon {
        cursor: pointer;
    }

    .header .drag-icon span {
        height: calc(var(--spacing) * 1);
        width: 100px;
        display: block;
        background-color: color-mix(in oklab, var(--foreground) 20%, transparent);
        border-radius: 9999px;
        margin-top: calc(var(--spacing) * 1);
    }

    .body {
        height: 100%;
        overflow-y: auto;
        padding: 1.5rem;
    }

    .body::-webkit-scrollbar {
        width: 0;
    }

    .links-docs {
        display: flex;
        flex-direction: column;
        gap: calc(var(--spacing) * 2);
    }

    .drawer-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: calc(var(--spacing) * 2);
        margin-top: calc(var(--spacing) * 6);
        padding-top: calc(var(--spacing) * 4);
        border-top: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    }

    .container-sidebar-entry {
        padding-top: calc(var(--spacing) * 6);
        display: flex;
        flex-direction: column;
        gap: calc(var(--spacing) * 2);

        &:last-child {
            margin-bottom: calc(var(--spacing) * 4);
        }
    }

    .entry-title {
        font-weight: 500;
    }

    .container-sidebar-entry a {
        font-size: 1rem;
        line-height: 1.2rem;
        color: var(--muted-foreground);
        text-decoration: inherit;

        &[data-active='true'] {
            color: var(--foreground);
            font-weight: 500;
        }
    }

    .badge {
        padding-top: calc(var(--spacing) * 0.5);
        padding-bottom: calc(var(--spacing) * 0.5);
        padding-left: calc(var(--spacing) * 1.5);
        padding-right: calc(var(--spacing) * 1.5);
        margin-left: calc(var(--spacing) * 2);
        border-radius: 0.375rem;
        font-size: 0.75rem;
        line-height: 1rem;
        font-weight: 400;
        line-height: 1;
        text-decoration: none;
        background: #adfa1d;
        color: #000000;
    }
</style>

<script>
    const drawer = document.getElementById('drawer');
    if (drawer) {
        drawer.addEventListener('toggle', (e) => {
            const event = e as ToggleEvent;
            const isOpen = event.newState === 'open';
            document.documentElement.style.overflow = isOpen ? 'hidden' : '';
            document.body.style.overflow = isOpen ? 'hidden' : '';
        });
    }
</script>
