# Application Settings
APP_NAME=My API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///dev.db
DATABASE_POOL_SIZE=10

# Security (JWT)
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Features
ENABLE_SWAGGER=true
ENABLE_CORS=true
CORS_ORIGINS=*
